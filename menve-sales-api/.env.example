# Com NODE_ENV=production: avisos no log se JWT/INTERNAL fracos. Para **falhar o deploy** se env inválida: ENFORCE_PRODUCTION_SECRETS=1
PORT=4000
# Opcional: 1 = não cria tenants demo/vendas/crm na subida (testes).
# SKIP_CANONICAL_BOOTSTRAP="1"
DATABASE_URL="postgresql://menve:menve@localhost:5432/menve_sales?schema=public"
# Mesmo valor que DATABASE_URL em dev local. No Neon: URL direta (sem "-pooler" no host) — evita P1002 em `prisma migrate deploy`.
DIRECT_URL="postgresql://menve:menve@localhost:5432/menve_sales?schema=public"
JWT_SECRET="change-me-match-root-env"
INTERNAL_API_KEY="dev-internal-key-change-me"
# true/1 = acesso por WorkspaceMembership + JWT novo formato (recomendado após migrate + backfill).
USE_WORKSPACE_MEMBERSHIP="false"
# URL do front (links de convite). Ex.: https://crm.menvedigital.com.br
PUBLIC_WEB_URL="http://localhost:3000"
# Opcional: envio de e-mail de convite (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM="Menve Sales <onboarding@resend.dev>"
PUBLIC_APP_URL="http://localhost:4000"
# Produção (origens permitidas no Nest enableCors). Ex.: https://vendas.menvedigital.com.br
# Vários hosts: separados por vírgula. Ver docs/DEPLOY-VENDAS-VERCEL-API.md
CORS_ORIGIN=""
# Base HTTP(S) da API Evolution (sem barra no final). Se o proxy expõe em subpath, inclua (ex.: https://api.exemplo.com/manager).
EVOLUTION_BASE_URL="http://localhost:8080"
EVOLUTION_API_KEY="dev-evolution-key"
EVOLUTION_WEBHOOK_SECRET=""
# Opcional: false = webhook sem mídia em base64 (POST menor; reaplicar webhook na Evolution)
EVOLUTION_WEBHOOK_BASE64="true"
META_VERIFY_TOKEN=""
# Com META_APP_SECRET definido, o POST /webhooks/whatsapp/meta exige X-Hub-Signature-256 válido (corpo bruto).
META_APP_SECRET=""
# Embedded Signup (futuro): OAuth Meta; ver GET /whatsapp-connections/meta-embedded-signup-info
META_EMBEDDED_SIGNUP_CLIENT_ID=""
META_EMBEDDED_SIGNUP_REDIRECT_URI=""
# Serper.dev — busca Google (aba Pesquisa). Opcional até usar /prospecting/search
SERPER_API_KEY=""
