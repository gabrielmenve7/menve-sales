generator client {
  provider = "prisma-client-js"
  /// Relativo a `menve-sales-api/prisma/`: sobe à raiz do monorepo — um único client para API Nest + Next (Vercel).
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Conexão sem pooler (Neon: host sem "-pooler"). Obrigatória para `migrate deploy` evitar P1002 no advisory lock.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  SELLER
}

/// Papel dentro de um workspace (Tenant). Alinhado a OWNER..SELLER; sem SUPER_ADMIN.
enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  SELLER
}

enum DealStatus {
  OPEN
  WON
  LOST
  ARCHIVED
}

/// Posição do estágio no funil (ícone “relógio” e filtros por categoria).
enum StageLifecycle {
  NOT_STARTED
  ACTIVE
  DONE
  CLOSED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  WHATSAPP
}

enum PipelineAutomationTriggerType {
  DEAL_CREATED
  DEAL_ENTERED_PIPELINE
  DEAL_ENTERED_STAGE
  DEAL_LEFT_STAGE
  DEAL_STAGE_TRANSITION
  DEAL_CUSTOM_FIELD_CHANGED
  DEAL_ASSIGNEE_ASSIGNED
  DEAL_ASSIGNEE_REMOVED
  CONTACT_TAG_ADDED
  CONTACT_TAG_REMOVED
  DEAL_MARKED_WON
  DEAL_MARKED_LOST
  PROSPECT_REPLIED
  COMPOSITE
}

enum PipelineAutomationRunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum WhatsAppProvider {
  META
  EVOLUTION
  ZAPPFY
  INSTAGRAM
}

enum OutreachCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum OutreachRecipientStatus {
  PENDING
  SENT
  DELIVERED
  REPLIED
  FAILED
  OPT_OUT
}

enum ConversationStatus {
  WAITING
  IN_PROGRESS
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

/// Confirmações de envio (estilo WhatsApp): enviada → entregue → lida.
enum MessageAckStatus {
  SENT
  DELIVERED
  READ
}

enum MessageSenderType {
  LEAD
  HUMAN_AGENT
  AI_AGENT
  SYSTEM
  CAMPAIGN
}

enum ConversationQualificationMode {
  NONE
  AI_ACTIVE
  AI_PAUSED
  HUMAN_HANDOFF
  COMPLETED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum CustomFieldEntity {
  CONTACT
  DEAL
}

enum ProspectSource {
  GOOGLE_SEARCH
  GOOGLE_MAPS
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISCARDED
}

enum ProspectSearchStatus {
  RUNNING
  ENRICHING
  DONE
  ERROR
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  plan            String   @default("free")
  /// Logo do workspace (URL https ou data URL).
  image           String?  @db.Text
  /// Quando false, Pesquisa (/prospecting) fica desativada para o workspace.
  researchEnabled         Boolean  @default(true)
  /// Segundos entre envios de disparo (throttle por instância).
  outreachThrottleSeconds Int      @default(45)
  /// Mensagem padrão para novas campanhas de disparo ({{nome}}, {{empresa}}, {{telefone}}).
  outreachDefaultTemplate String?  @db.Text
  /// Regras de lead scoring (JSON).
  leadScoringRules        Json?
  /// Agente Gabriel (SDR IA) ativo para qualificação pós-disparo.
  gabrielEnabled          Boolean  @default(false)
  gabrielModel            String?
  gabrielReplyDelayMs     Int      @default(1500)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users                   User[]
  contacts                Contact[]
  pipelines               Pipeline[]
  tags                    Tag[]
  customFields            CustomField[]
  campaignSources         CampaignSource[]
  whatsappConnections     WhatsAppConnection[]
  conversations           Conversation[]
  deals                   Deal[]
  activities              Activity[]
  messages                Message[]
  quickReplies            QuickReply[]
  quickReplyCategories    QuickReplyCategory[]
  prospectSearches        ProspectSearch[]
  prospectResults         ProspectResult[]
  dashboardBoards         DashboardBoard[]
  pipelineAutomationRules PipelineAutomationRule[]
  workspaceMemberships    WorkspaceMembership[]
  workspaceInvites        WorkspaceInvite[]
  products                Product[]
  productCollections      ProductCollection[]
  dealItems               DealItem[]
  prospectLists           ProspectList[]
  outreachCampaigns       OutreachCampaign[]
  aiAgentSkills           AiAgentSkill[]
  agentRuns               AgentRun[]
}

/// Coleções do catálogo (agrupamento opcional de produtos por tenant).
model ProductCollection {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Catálogo de produtos por tenant (nome + preço base). Linhas em oportunidades no funil podem referenciar estes itens via `DealItem`.
model Product {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   ProductCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  name         String
  price        Decimal            @db.Decimal(12, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  dealItems DealItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([collectionId])
}

/// Linha de produto em uma oportunidade do funil. Soma de (quantity * unitPrice) define o valor do `Deal`.
model DealItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Nome do produto no momento do registro (mantém histórico se o produto for removido/renomeado).
  productName String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, dealId])
  @@index([productId])
}

model WorkspaceMembership {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      WorkspaceRole
  joinedAt  DateTime      @default(now())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model WorkspaceInvite {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailNormalized String
  role            WorkspaceRole
  tokenHash       String        @unique
  expiresAt       DateTime
  invitedByUserId String?
  invitedBy       User?         @relation("WorkspaceInviteInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?

  @@index([tenantId, emailNormalized])
}

/// Etapa / macro-fase (ex.: Qualificação) — agrupa scripts de resposta rápida no Inbox.
model QuickReplyCategory {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  replies   QuickReply[]

  @@index([tenantId, sortOrder])
}

model QuickReply {
  id         String             @id @default(cuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String
  category   QuickReplyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  body       String
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())

  @@index([tenantId, sortOrder])
  @@index([categoryId, sortOrder])
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String?
  name               String?
  /// Foto de perfil: URL https ou data URL (imagem).
  image              String?  @db.Text
  role               UserRole @default(SELLER)
  tenantId           String?
  tenant             Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Último workspace ativo (sessão); usado ao fazer login com vários memberships.
  lastActiveTenantId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspaceMemberships WorkspaceMembership[]
  invitesSent          WorkspaceInvite[]     @relation("WorkspaceInviteInviter")

  assignedDeals                  Deal[]                   @relation("AssignedDeals")
  activities                     Activity[]
  messages                       Message[]
  conversations                  Conversation[]           @relation("AssignedConversations")
  internalNotes                  InternalNote[]
  prospectSearches               ProspectSearch[]         @relation("ProspectSearches")
  dashboardBoards                DashboardBoard[]
  createdPipelineAutomationRules PipelineAutomationRule[] @relation("PipelineAutomationCreatedBy")
  prospectListsCreated         ProspectList[]           @relation("ProspectListsCreated")
  outreachCampaignsCreated     OutreachCampaign[]       @relation("OutreachCampaignsCreated")
  googleCalendar               UserGoogleCalendar?
}

model DashboardBoard {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  layoutJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, userId])
}

model Contact {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  phone            String?
  email            String?
  company          String?
  jobTitle         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  campaignSourceId String?
  campaignSource   CampaignSource? @relation(fields: [campaignSourceId], references: [id])
  customData           Json?
  leadScore            Int             @default(0)
  leadScoreUpdatedAt   DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  deals           Deal[]
  activities      Activity[]
  messages        Message[]
  conversations   Conversation[]
  contactTags     ContactTag[]
  prospectResults         ProspectResult[]
  prospectListItems       ProspectListItem[]
  outreachRecipients      OutreachCampaignRecipient[]

  @@unique([tenantId, phone])
  @@index([tenantId, email])
}

model ProspectSearch {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation("ProspectSearches", fields: [userId], references: [id])
  query              String
  location           String?
  webCount           Int      @default(0)
  mapsCount          Int      @default(0)
  totalCount         Int      @default(0)
  /**
   * Última página da busca orgânica Google (Serper) já consumida; próximo "carregar mais" usa página + 1.
   */
  lastWebPageFetched Int      @default(1)
  /**
   * Não há mais páginas orgânicas no Google para esta query.
   */
  webExhausted       Boolean  @default(false)
  segment            String?
  state              String?
  city               String?
  engines            String[] @default([])
  status             ProspectSearchStatus @default(RUNNING)
  qualifiedCount     Int      @default(0)
  errorMessage       String?
  createdAt          DateTime @default(now())

  results ProspectResult[]

  @@index([tenantId, createdAt])
}

model ProspectResult {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchId       String
  search         ProspectSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  source         ProspectSource
  position       Int?
  name           String
  website        String?
  hasWebsite     Boolean        @default(false)
  phone          String?
  address        String?
  snippet        String?
  rating         Float?
  reviewCount    Int?
  googleMapsUrl  String?
  whatsapp       String?
  email          String?
  enrichmentData Json?
  enrichedAt     DateTime?
  status         ProspectStatus @default(NEW)
  notes          String?
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId, searchId])
  @@index([tenantId, status])
  @@index([searchId, enrichedAt])
  prospectListItems ProspectListItem[]
}

model ProspectList {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// `primary` = lista principal do workspace (uma por tenant).
  code        String?
  createdById String
  createdBy   User     @relation("ProspectListsCreated", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     ProspectListItem[]
  campaigns OutreachCampaign[]

  @@index([tenantId, createdAt])
  @@index([tenantId, code])
}

model ProspectListItem {
  id               String          @id @default(cuid())
  listId           String
  list             ProspectList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  prospectResultId String?
  prospectResult   ProspectResult? @relation(fields: [prospectResultId], references: [id], onDelete: SetNull)
  contactId        String?
  contact          Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@unique([listId, prospectResultId])
  @@index([listId])
}

model OutreachCampaign {
  id           String                 @id @default(cuid())
  tenantId     String
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listId       String?
  list         ProspectList?          @relation(fields: [listId], references: [id], onDelete: SetNull)
  connectionId String
  connection   WhatsAppConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  name         String
  templateBody String                 @db.Text
  status       OutreachCampaignStatus @default(DRAFT)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdById  String
  createdBy    User                   @relation("OutreachCampaignsCreated", fields: [createdById], references: [id])
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  recipients   OutreachCampaignRecipient[]
  sequenceSteps OutreachSequenceStep[]
  messages     Message[]

  @@index([tenantId, status])
}

model OutreachCampaignRecipient {
  id             String                  @id @default(cuid())
  campaignId     String
  campaign       OutreachCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone          String
  name           String?
  company        String?
  status         OutreachRecipientStatus @default(PENDING)
  sentAt         DateTime?
  repliedAt      DateTime?
  errorMessage   String?
  contactId      String?
  contact        Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId String?
  messageId      String?
  nextSendAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  conversations Conversation[]

  @@unique([campaignId, phone])
  @@index([campaignId, status])
}

model OutreachSequenceStep {
  id           String           @id @default(cuid())
  campaignId   String
  campaign     OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sortOrder    Int              @default(0)
  delayDays    Int              @default(3)
  templateBody String           @db.Text
  createdAt    DateTime         @default(now())

  @@index([campaignId, sortOrder])
}

model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  color     String?
  /** Etapa cujo Kanban marca a oportunidade como ganha (alimenta métricas WON). */
  wonStageId  String?
  wonStage    Stage?  @relation("PipelineWonStage", fields: [wonStageId], references: [id], onDelete: SetNull)
  /** Etapa cujo Kanban marca a oportunidade como perdida (alimenta métricas LOST). */
  lostStageId String?
  lostStage   Stage?  @relation("PipelineLostStage", fields: [lostStageId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages          Stage[]
  deals           Deal[]
  automationRules PipelineAutomationRule[]
}

model Stage {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int
  probability Float?
  color       String?
  lifecycle   StageLifecycle @default(ACTIVE)
  deals       Deal[]
  pipelinesMarkedWon  Pipeline[] @relation("PipelineWonStage")
  pipelinesMarkedLost Pipeline[] @relation("PipelineLostStage")

  @@unique([pipelineId, sortOrder])
}

model Deal {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipelineId    String
  pipeline      Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId       String
  stage         Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  title         String
  value         Decimal?   @db.Decimal(12, 2)
  probability   Float?
  expectedClose DateTime?
  status        DealStatus @default(OPEN)
  lostReason    String?
  assignedToId  String?
  assignedTo    User?      @relation("AssignedDeals", fields: [assignedToId], references: [id])
  customData    Json?
  /// Visível em Gestão de leads (`/pipeline`) após criação manual (POST /deals) ou promoção por Google Meet.
  pipelineVisible   Boolean   @default(false)
  pipelineEnteredAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  activities                    Activity[]
  dealTags                      DealTag[]
  pipelineAutomationRuns        PipelineAutomationRun[]
  pipelineAutomationAndProgress PipelineAutomationAndProgress[]
  items                         DealItem[]

  @@index([tenantId, stageId])
  @@index([tenantId, pipelineId, status])
  @@index([tenantId, pipelineId, pipelineVisible])
}

model PipelineAutomationRule {
  id              String                          @id @default(cuid())
  tenantId        String
  tenant          Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipelineId      String
  pipeline        Pipeline                        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean                         @default(true)
  sortOrder       Int                             @default(0)
  triggerType     PipelineAutomationTriggerType
  triggerFilter   Json?
  actions         Json
  createdByUserId String?
  createdBy       User?                           @relation("PipelineAutomationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  runs            PipelineAutomationRun[]
  andProgress     PipelineAutomationAndProgress[]

  @@index([tenantId, pipelineId, enabled])
}

model PipelineAutomationAndProgress {
  id        String                 @id @default(cuid())
  tenantId  String
  ruleId    String
  dealId    String
  mask      Int                    @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  rule      PipelineAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  deal      Deal                   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([ruleId, dealId])
  @@index([tenantId, ruleId])
}

model PipelineAutomationRun {
  id              String                        @id @default(cuid())
  tenantId        String
  ruleId          String
  rule            PipelineAutomationRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dealId          String
  deal            Deal                          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  triggerType     PipelineAutomationTriggerType
  status          PipelineAutomationRunStatus
  errorMessage    String?
  executedActions Json?
  createdAt       DateTime                      @default(now())

  @@index([tenantId, ruleId])
  @@index([tenantId, dealId, createdAt])
}

model DealTag {
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
}

model Tag {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  deals       DealTag[]
  contactTags ContactTag[]

  @@unique([tenantId, name])
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model CustomField {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  key         String
  fieldType   String
  options     Json?
  entity      CustomFieldEntity @default(CONTACT)
  sortOrder   Int               @default(0)
  required    Boolean           @default(false)

  @@unique([tenantId, key])
  @@index([tenantId, entity, sortOrder])
}

model CampaignSource {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  code     String?

  contacts Contact[]
}

model Activity {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  type        ActivityType
  title       String
  description String?
  dueAt         DateTime?
  completedAt   DateTime?
  meetLink      String?
  googleEventId String?
  createdAt     DateTime     @default(now())

  @@index([tenantId, dueAt])
}

model UserGoogleCalendar {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @db.Text
  calendarId   String?
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WhatsAppConnection {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider  WhatsAppProvider
  name      String
  isActive  Boolean          @default(true)
  config    Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  messages      Message[]
  conversations Conversation[]
  outreachCampaigns OutreachCampaign[]
}

model Conversation {
  id                   String                        @id @default(cuid())
  tenantId             String
  tenant               Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId            String
  contact              Contact                       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappConnectionId String
  whatsappConnection   WhatsAppConnection            @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)
  assignedUserId       String?
  assignedUser         User?                         @relation("AssignedConversations", fields: [assignedUserId], references: [id])
  status               ConversationStatus            @default(WAITING)
  qualificationMode    ConversationQualificationMode @default(NONE)
  aiAgentId            String?
  aiAgent              AiAgent?                      @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  aiPausedAt           DateTime?
  handoffAt            DateTime?
  handoffReason        String?
  outreachRecipientId  String?
  outreachRecipient    OutreachCampaignRecipient?    @relation(fields: [outreachRecipientId], references: [id], onDelete: SetNull)
  lastMessageAt        DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  messages      Message[]
  internalNotes InternalNote[]
  agentRuns     AgentRun[]

  @@index([tenantId, lastMessageAt])
  @@index([tenantId, qualificationMode, lastMessageAt])
}

model InternalNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
}

model Message {
  id                   String             @id @default(cuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappConnectionId String
  whatsappConnection   WhatsAppConnection @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)
  conversationId       String?
  conversation         Conversation?      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contactId            String
  contact              Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?              @relation(fields: [userId], references: [id])
  direction            MessageDirection
  senderType           MessageSenderType  @default(LEAD)
  aiAgentId            String?
  aiAgent              AiAgent?           @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  agentRunId           String?
  agentRun             AgentRun?          @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  outreachCampaignId   String?
  outreachCampaign     OutreachCampaign?  @relation(fields: [outreachCampaignId], references: [id], onDelete: SetNull)
  body                 String
  mediaUrl             String?
  mediaType            String?
  /// Transcrição Whisper de áudio inbound (para agentes IA).
  audioTranscript      String?
  externalId           String?
  /// Somente OUTBOUND; inbound permanece null.
  ackStatus            MessageAckStatus?
  createdAt            DateTime           @default(now())

  @@index([tenantId, contactId, createdAt])
  @@index([conversationId, createdAt])
}

/// Catálogo de agentes IA (MVP: Gabriel).
model AiAgent {
  id          String   @id @default(cuid())
  key         String   @unique
  displayName String
  description String?
  avatarUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills        AiAgentSkill[]
  conversations Conversation[]
  messages      Message[]
  agentRuns     AgentRun[]
}

/// Skills do agente por tenant (espelho de `.cursor/rules/agent-{chave}.mdc`).
model AiAgentSkill {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId    String
  agent      AiAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillKey   String
  content    String   @db.Text
  sourcePath String?
  version    Int      @default(1)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, agentId, skillKey])
  @@index([tenantId, agentId])
}

/// Auditoria de cada turno do agente IA.
model AgentRun {
  id                   String         @id @default(cuid())
  tenantId             String
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId       String
  conversation         Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentId              String
  agent                AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  triggerMessageId     String?
  status               AgentRunStatus @default(PENDING)
  promptTokens         Int?
  completionTokens     Int?
  error                String?        @db.Text
  toolCalls            Json?
  skillVersionSnapshot Json?
  startedAt            DateTime       @default(now())
  finishedAt           DateTime?

  messages Message[]

  @@index([conversationId, startedAt])
  @@index([tenantId, status, startedAt])
}
