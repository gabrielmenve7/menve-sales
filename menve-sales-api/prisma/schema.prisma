generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Conexão sem pooler (Neon: host sem "-pooler"). Obrigatória para `migrate deploy` evitar P1002 no advisory lock.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  SELLER
}

enum DealStatus {
  OPEN
  WON
  LOST
  ARCHIVED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  WHATSAPP
}

enum PipelineAutomationTriggerType {
  DEAL_CREATED
  DEAL_ENTERED_STAGE
  DEAL_LEFT_STAGE
  DEAL_MARKED_WON
  DEAL_MARKED_LOST
}

enum PipelineAutomationRunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum WhatsAppProvider {
  META
  EVOLUTION
  INSTAGRAM
}

enum ConversationStatus {
  WAITING
  IN_PROGRESS
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

/// Confirmações de envio (estilo WhatsApp): enviada → entregue → lida.
enum MessageAckStatus {
  SENT
  DELIVERED
  READ
}

enum CustomFieldEntity {
  CONTACT
  DEAL
}

enum ProspectSource {
  GOOGLE_SEARCH
  GOOGLE_MAPS
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISCARDED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  /// Logo do workspace (URL https ou data URL).
  image     String?  @db.Text
  /// Quando false, Pesquisa (/prospecting) fica desativada para o workspace.
  researchEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  contacts            Contact[]
  pipelines           Pipeline[]
  tags                Tag[]
  customFields        CustomField[]
  campaignSources     CampaignSource[]
  whatsappConnections WhatsAppConnection[]
  conversations       Conversation[]
  deals               Deal[]
  activities          Activity[]
  messages            Message[]
  quickReplies           QuickReply[]
  quickReplyCategories   QuickReplyCategory[]
  prospectSearches       ProspectSearch[]
  prospectResults     ProspectResult[]
  dashboardBoards            DashboardBoard[]
  pipelineAutomationRules    PipelineAutomationRule[]
}

/// Etapa / macro-fase (ex.: Qualificação) — agrupa scripts de resposta rápida no Inbox.
model QuickReplyCategory {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  replies   QuickReply[]

  @@index([tenantId, sortOrder])
}

model QuickReply {
  id         String             @id @default(cuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String
  category   QuickReplyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  body       String
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())

  @@index([tenantId, sortOrder])
  @@index([categoryId, sortOrder])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  /// Foto de perfil: URL https ou data URL (imagem).
  image        String?  @db.Text
  role         UserRole @default(SELLER)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedDeals    Deal[]         @relation("AssignedDeals")
  activities       Activity[]
  messages         Message[]
  conversations    Conversation[] @relation("AssignedConversations")
  internalNotes    InternalNote[]
  prospectSearches ProspectSearch[] @relation("ProspectSearches")
  dashboardBoards                DashboardBoard[]
  createdPipelineAutomationRules PipelineAutomationRule[] @relation("PipelineAutomationCreatedBy")
}

model DashboardBoard {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  layoutJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, userId])
}

model Contact {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  phone            String?
  email            String?
  company          String?
  jobTitle         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  campaignSourceId String?
  campaignSource   CampaignSource? @relation(fields: [campaignSourceId], references: [id])
  customData       Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  deals         Deal[]
  activities    Activity[]
  messages      Message[]
  conversations Conversation[]
  contactTags   ContactTag[]
  prospectResults ProspectResult[]

  @@unique([tenantId, phone])
  @@index([tenantId, email])
}

model ProspectSearch {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("ProspectSearches", fields: [userId], references: [id])
  query      String
  location   String?
  webCount            Int      @default(0)
  mapsCount           Int      @default(0)
  totalCount          Int      @default(0)
  /** Última página da busca orgânica Google (Serper) já consumida; próximo "carregar mais" usa página + 1. */
  lastWebPageFetched  Int      @default(1)
  /** Não há mais páginas orgânicas no Google para esta query. */
  webExhausted        Boolean  @default(false)
  createdAt           DateTime @default(now())

  results ProspectResult[]

  @@index([tenantId, createdAt])
}

model ProspectResult {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchId      String
  search        ProspectSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  source        ProspectSource
  position      Int?
  name          String
  website       String?
  hasWebsite    Boolean        @default(false)
  phone         String?
  address       String?
  snippet       String?
  rating        Float?
  reviewCount   Int?
  googleMapsUrl String?
  whatsapp      String?
  email         String?
  enrichmentData Json?
  enrichedAt    DateTime?
  status        ProspectStatus @default(NEW)
  notes         String?
  contactId     String?
  contact       Contact?       @relation(fields: [contactId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, searchId])
  @@index([tenantId, status])
  @@index([searchId, enrichedAt])
}

model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages            Stage[]
  deals             Deal[]
  automationRules   PipelineAutomationRule[]
}

model Stage {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int
  probability Float?
  color       String?
  deals       Deal[]

  @@unique([pipelineId, sortOrder])
}

model Deal {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipelineId    String
  pipeline      Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId       String
  stage         Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  title         String
  value         Decimal?   @db.Decimal(12, 2)
  probability   Float?
  expectedClose DateTime?
  status        DealStatus @default(OPEN)
  lostReason    String?
  assignedToId  String?
  assignedTo    User?      @relation("AssignedDeals", fields: [assignedToId], references: [id])
  customData    Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  activities               Activity[]
  dealTags                 DealTag[]
  pipelineAutomationRuns   PipelineAutomationRun[]

  @@index([tenantId, stageId])
}

model PipelineAutomationRule {
  id              String                        @id @default(cuid())
  tenantId        String
  tenant          Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipelineId      String
  pipeline        Pipeline                      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean                       @default(true)
  sortOrder       Int                           @default(0)
  triggerType     PipelineAutomationTriggerType
  triggerFilter   Json?
  actions         Json
  createdByUserId String?
  createdBy       User?                         @relation("PipelineAutomationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  runs            PipelineAutomationRun[]

  @@index([tenantId, pipelineId, enabled])
}

model PipelineAutomationRun {
  id              String                        @id @default(cuid())
  tenantId        String
  ruleId          String
  rule            PipelineAutomationRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dealId          String
  deal            Deal                          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  triggerType     PipelineAutomationTriggerType
  status          PipelineAutomationRunStatus
  errorMessage    String?
  executedActions Json?
  createdAt       DateTime                      @default(now())

  @@index([tenantId, ruleId])
  @@index([tenantId, dealId, createdAt])
}

model DealTag {
  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
}

model Tag {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  deals       DealTag[]
  contactTags ContactTag[]

  @@unique([tenantId, name])
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model CustomField {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  description String?
  key       String
  fieldType String
  options   Json?
  entity    CustomFieldEntity @default(CONTACT)
  sortOrder Int               @default(0)
  required  Boolean           @default(false)

  @@unique([tenantId, key])
  @@index([tenantId, entity, sortOrder])
}

model CampaignSource {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?

  contacts Contact[]
}

model Activity {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  type        ActivityType
  title       String
  description String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([tenantId, dueAt])
}

model WhatsAppConnection {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider  WhatsAppProvider
  name      String
  isActive  Boolean          @default(true)
  config    Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  messages      Message[]
  conversations Conversation[]
}

model Conversation {
  id                   String             @id @default(cuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId            String
  contact              Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappConnectionId String
  whatsappConnection   WhatsAppConnection @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)
  assignedUserId       String?
  assignedUser         User?              @relation("AssignedConversations", fields: [assignedUserId], references: [id])
  status               ConversationStatus @default(WAITING)
  lastMessageAt        DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  messages      Message[]
  internalNotes InternalNote[]

  @@index([tenantId, lastMessageAt])
}

model InternalNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
}

model Message {
  id                   String             @id @default(cuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappConnectionId String
  whatsappConnection   WhatsAppConnection @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)
  conversationId       String?
  conversation         Conversation?      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contactId            String
  contact              Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?              @relation(fields: [userId], references: [id])
  direction            MessageDirection
  body                 String
  mediaUrl             String?
  mediaType            String?
  externalId           String?
  /// Somente OUTBOUND; inbound permanece null.
  ackStatus            MessageAckStatus?
  createdAt            DateTime           @default(now())

  @@index([tenantId, contactId, createdAt])
}
