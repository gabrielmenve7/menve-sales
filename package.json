{
  "name": "menve-sales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --schema ./menve-sales-api/prisma/schema.prisma",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run start:dev --prefix menve-sales-web",
    "dev:web:3001": "npm run start:dev:3001 --prefix menve-sales-web",
    "dev:api": "npm run start:dev --prefix menve-sales-api",
    "build": "npm run build --prefix menve-sales-web",
    "build:web": "npm run build --prefix menve-sales-web",
    "start": "npm run start --prefix menve-sales-web",
    "start:api": "npm run start --prefix menve-sales-api",
    "start:e2e": "concurrently -k -n api,web \"npm run start:api\" \"npx wait-on -t 120000 http://127.0.0.1:4000/health && npm run start\"",
    "lint": "eslint ./menve-sales-web/src",
    "db:push": "npm run db:push --prefix menve-sales-api",
    "db:migrate": "npm run db:migrate --prefix menve-sales-api",
    "db:deploy": "npm run db:deploy --prefix menve-sales-api",
    "db:seed": "npm run db:seed --prefix menve-sales-api",
    "db:studio": "npm run db:studio --prefix menve-sales-api",
    "whatsapp:golive-check": "tsx ./menve-sales-api/scripts/whatsapp-golive-check.ts",
    "whatsapp:inbound-e2e": "tsx ./menve-sales-api/scripts/whatsapp-inbound-e2e.ts",
    "whatsapp:outbound-e2e": "tsx ./menve-sales-api/scripts/whatsapp-outbound-e2e.ts",
    "test": "vitest --config ./menve-sales-web/vitest.config.ts",
    "test:e2e": "playwright test --config ./menve-sales-web/playwright.config.ts",
    "smoke:prod": "tsx ./menve-sales-api/scripts/smoke-production-check.ts",
    "deploy:vercel": "npx --yes vercel@latest deploy --prod --yes"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tanstack/react-query": "^5.67.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.479.0",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.4",
    "react-grid-layout": "^2.2.3",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3",
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-grid-layout": "^1.3.6",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.1"
  }
}
