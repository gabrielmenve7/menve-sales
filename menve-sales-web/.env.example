# Cópia para a Vercel (Production / Preview). O browser não acessa a API Nest direto:
# o Next chama a API no servidor (server actions / RSC) com estes valores.
#
# URL pública da API Nest (Railway), sem barra no final — ex.:
# INTERNAL_API_URL=https://menve-sales-production.up.railway.app
INTERNAL_API_URL=http://localhost:4000
#
# Mesmo valor definido em INTERNAL_API_KEY no serviço da API.
INTERNAL_API_KEY=dev-internal-key-change-me
#
# Opcional: exibir URLs de webhook na UI (senão usa INTERNAL_API_URL / NEXT_PUBLIC_APP_URL)
# WEBHOOK_PUBLIC_URL=https://menve-sales-production.up.railway.app
#
# --- Diagnóstico de tenant / QR / settings ---
# O primeiro rótulo do host vira slug do tenant (exceto *.vercel.app e www).
# Se o CRM está em crm.seudominio.com, o slug vira "crm" — precisa existir no banco OU:
# DEFAULT_TENANT_SLUG=vendas
# DATABASE_URL (+ DIRECT_URL) na Vercel permitem resolver tenant pelo Postgres no servidor.
#
# Script (na máquina, com env da API): DIAGNOSTIC_USER_ID=<uuid-user> npx tsx menve-sales-api/scripts/diagnose-internal-bridge.ts
#
# Igual à Railway se usam workspaces: papel (OWNER/ADMIN/…) vem do tenant ativo.
# USE_WORKSPACE_MEMBERSHIP=true
