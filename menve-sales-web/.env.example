# Cópia para a Vercel (Production / Preview). O browser não acessa a API Nest direto:
# o Next chama a API no servidor (server actions / RSC) com estes valores.
#
# URL pública da API Nest (Railway), sem barra no final — ex.:
# INTERNAL_API_URL=https://menve-sales-production.up.railway.app
INTERNAL_API_URL=http://localhost:4000
#
# Mesmo valor definido em INTERNAL_API_KEY no serviço da API.
INTERNAL_API_KEY=dev-internal-key-change-me
#
# Opcional: exibir URLs de webhook na UI (senão usa INTERNAL_API_URL / NEXT_PUBLIC_APP_URL)
# WEBHOOK_PUBLIC_URL=https://menve-sales-production.up.railway.app
