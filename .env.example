# --- Desenvolvimento local (copie para .env) ---
DATABASE_URL="postgresql://menve:menve@localhost:5432/menve_sales?schema=public"
# Copie também para menve-sales-api/.env. Neon: pooler em DATABASE_URL, conexão direta (sem -pooler) em DIRECT_URL — evita P1002 no migrate.
DIRECT_URL="postgresql://menve:menve@localhost:5432/menve_sales?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Obrigatório para sessão/login. Auth.js v5 também aceita AUTH_SECRET (equivalente).
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Se a porta 3000 estiver ocupada: na pasta menve-sales-web use `npm run start:dev:3001`
# (ou na raiz `npm run dev:web:3001`) e alinhe as URLs abaixo para :3001
# NEXTAUTH_URL="http://localhost:3001"
# NEXT_PUBLIC_APP_URL="http://localhost:3001"
# AUTH_URL="http://localhost:3001"
# Seed cria tenants `demo`, `menve-digital` e `vendas` (slug para https://vendas.menvedigital.com.br).
# owner@vendas.menvedigital.local / admin123 — altere senhas após o primeiro login em produção.
DEFAULT_TENANT_SLUG="demo"

# Nest API (menve-sales-api) — Next.js chama com x-api-key + contexto de tenant
INTERNAL_API_URL="http://localhost:4000"
INTERNAL_API_KEY="dev-internal-key-change-me"
# JWT do backend (login /auth/login) — mesmo segredo no processo da API
JWT_SECRET="change-me-same-as-api-openssl-rand-base64-32"
# URL pública da API para Evolution/Meta webhooks (path /webhooks/whatsapp/...)
# Em dev costuma ser http://localhost:4000; em produção, https://api.seudominio.com
PUBLIC_APP_URL="http://localhost:4000"
# Opcional: só para exibir URLs na tela de Configurações (default = INTERNAL_API_URL)
# WEBHOOK_PUBLIC_URL="https://api.seudominio.com"

# Opcional: espelho da URL pública (Auth.js v5 / alguns hosts)
# AUTH_URL="http://localhost:3000"

# Redis: não é usado pelo app Next.js no MVP. O serviço redis no docker-compose
# atende principalmente a Evolution API. Omita em PaaS se não usar Evolution local.
REDIS_URL="redis://localhost:6379"

# Evolution API (docker-compose) — URL pública onde a Evolution está exposta (local: http://localhost:8080)
EVOLUTION_BASE_URL="http://localhost:8080"
# Mesmo valor em AUTHENTICATION_API_KEY no compose / painel da Evolution
EVOLUTION_API_KEY="dev-evolution-key"

# Evolution webhook (opcional)
EVOLUTION_WEBHOOK_SECRET=""
# Controla ingestão de mensagens de grupo no Inbox da Evolution.
# false (padrão recomendado): só mensagens 1:1
# true: inclui grupos (@g.us)
WHATSAPP_ALLOW_GROUPS="false"

# Meta Cloud API webhook
META_VERIFY_TOKEN=""
META_APP_SECRET=""

# --- Produção: web na Vercel + API em PaaS (guia completo: docs/DEPLOY-VENDAS-VERCEL-API.md) ---
# DATABASE_URL / DIRECT_URL — Neon: pooler + direto (mesmo par na Vercel e na API)
# NEXTAUTH_URL=https://vendas.menvedigital.com.br
# NEXT_PUBLIC_APP_URL=https://vendas.menvedigital.com.br
# INTERNAL_API_URL=https://api.vendas.menvedigital.com.br
# INTERNAL_API_KEY=<mesmo valor na API Nest>
# NEXTAUTH_SECRET ou AUTH_SECRET=<openssl rand -base64 32>
# Em vendas.menvedigital.com.br o slug do tenant é "vendas" (seed cria tenant + owner@vendas.menvedigital.local)
# EVOLUTION_* / META_* conforme menve-sales-api/docs/WHATSAPP-GOLIVE.md
#
# Build Vercel: vercel.json roda prisma migrate deploy antes do next build.
# Smoke: npm run smoke:prod -- https://api... https://vendas...
